# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.  The default below matches the local Docker setup.
DATABASE_URL=postgresql+asyncpg://fixly:fixly@localhost:5433/fixly

# Set to "true" to print every SQL statement to stdout (useful for debugging).
DATABASE_ECHO=false

# ── Security ──────────────────────────────────────────────────────────────────
# Random secret used for session token signing.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-hex-string

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that are granted admin access.
# Users who register with these emails will have is_admin=True set automatically.
ADMIN_EMAILS=admin@example.com

# ── AI Provider — local Ollama ────────────────────────────────────────────────
# No cloud API key needed.  Models are served locally by Ollama.
# Make sure Ollama is running:  ollama serve
# Check it is up:               curl http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# How long (in seconds) Ollama keeps a model loaded in VRAM after the last request.
# 0 = unload immediately after each call (saves GPU memory, adds cold-start delay).
# -1 = keep loaded indefinitely.  Recommended: 0 for limited VRAM, 300 for demos.
OLLAMA_KEEP_ALIVE=0

# Stage 1 — vision / problem classification (Qwen2.5-VL, multimodal)
# Pull with:  ollama pull qwen2.5vl:7b
STAGE_1_MODEL=qwen2.5vl:7b

# Context window for Stage 1 model.  4096 works for most image cases.
# Increase to 8192 if the model returns truncated JSON on complex images.
STAGE_1_NUM_CTX=4096

# Stage 2 — tools / materials / protective gear (Mistral, text)
# Pull with:  ollama pull mistral:7b-instruct
STAGE_2_MODEL=mistral:7b-instruct

# Stage 3 — step-by-step repair instructions (Llama 3.1, text)
# Pull with:  ollama pull llama3.1:8b
STAGE_3_MODEL=llama3.1:8b

# How many times each stage will retry if the model returns invalid JSON.
# Increase if your local models are producing inconsistent output.
PIPELINE_RETRY_COUNT=2

# ── Judge model (admin Quality Dashboard) ────────────────────────────────────
# Set JUDGE_ENABLED=true to enable the pipeline quality auditor and the
# Advisory Fix Proposal feature.  Requires JUDGE_MODEL to be pulled first.
# Pull with:  ollama pull qwen2.5:7b
JUDGE_ENABLED=false
JUDGE_MODEL=qwen2.5:7b

# ── Video analysis (optional — requires GPU + HuggingFace Transformers) ───────
# Set VIDEO_ANALYSIS_ENABLED=true to enable short-video case analysis.
# Requires the packages in backend/requirements-video.txt and a CUDA-capable GPU.
# The model is downloaded from HuggingFace on first use (~15 GB).
VIDEO_ANALYSIS_ENABLED=false
VIDEO_MODEL_LOCAL=Qwen/Qwen2.5-VL-7B-Instruct
VIDEO_NFRAMES=8

# ── Frontend connection ───────────────────────────────────────────────────────
# URL the NiceGUI frontend uses to reach the FastAPI backend.
# Change the port if you run the backend on a different port.
BACKEND_URL=http://localhost:8000
